<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBK – Einreichen" Width="1000" Height="680" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#FAFAF8">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button x:Name="k_einlesen" DockPanel.Dock="Right" Content="Neu einlesen" Padding="10,2"
              ToolTip="Durchbrüche und Zustand im Projektordner neu einlesen (nach Änderungen im Modell)"/>
      <TextBlock x:Name="kopf" Foreground="#5F5E5A" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="meldung" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5F5E5A"/>
    <TabControl x:Name="tabs">

      <TabItem Header="  1 · Pakete  ">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#5F5E5A" Margin="0,0,0,6"
                       Text="Ein Paket = eine 3D-Ansicht in Revit. Durchbruch-Pakete werden als Prüfobjekte eingereicht, TGA-Pakete als IFC-Modell veröffentlicht. Was in der Ansicht sichtbar ist, geht raus."/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <Button x:Name="k_neu_db" Content="+ Durchbruch-Paket" Padding="8,2" ToolTip="z. B. „Durchbrüche EG“ – Filter nach Ebene und Familie"/>
              <Button x:Name="k_neu_tga" Content="+ TGA-Paket" Padding="8,2" Margin="6,0,0,0" ToolTip="z. B. „TGA ohne Durchbrüche“ oder „Lüftung EG“"/>
              <Button x:Name="k_entfernen" Content="Entfernen" Padding="8,2" Margin="6,0,0,0" ToolTip="Paket aus der Liste entfernen (die Revit-Ansicht bleibt bestehen)"/>
            </WrapPanel>
            <ListView x:Name="liste" BorderBrush="#DCDAD2">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Paket" Width="170" DisplayMemberBinding="{Binding name}"/>
                  <GridViewColumn Header="Art" Width="110" DisplayMemberBinding="{Binding art}"/>
                  <GridViewColumn Header="Filter" Width="210" DisplayMemberBinding="{Binding filter}"/>
                  <GridViewColumn Header="Umfang" Width="120" DisplayMemberBinding="{Binding umfang}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
          <Border Grid.Column="1" Background="White" BorderBrush="#DCDAD2" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel x:Name="editor" IsEnabled="False">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="e_art" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Name (wird Teil des Ansichtsnamens)" Foreground="#5F5E5A"/>
                <TextBox x:Name="e_name" Height="26" Margin="0,2,0,6" VerticalContentAlignment="Center"/>
                <TextBlock Text="Kürzel im Viewer" Foreground="#5F5E5A"/>
                <TextBox x:Name="e_kuerzel" Height="26" Margin="0,2,0,6" VerticalContentAlignment="Center"
                         ToolTip="Jedes exportierte Paket ist im Viewer ein eigenes, schaltbares Modell"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <CheckBox x:Name="e_ifc" Content="Zusätzlich als IFC veröffentlichen" Margin="0,0,0,6"
                          ToolTip="Durchbrüche auch als IFC-Modell (z. B. für andere Programme). Im Viewer erscheinen sie ohnehin als Prüfobjekte."/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="k_speichern" Content="Speichern" Padding="10,3"/>
                  <Button x:Name="k_3d" Content="3D-Ansicht zeigen" Padding="10,3" Margin="6,0,0,0"
                          ToolTip="Speichert, baut die Ansicht „DBK Paket – Name“ auf und öffnet sie. Das Fenster bleibt offen."/>
                </StackPanel>
              </StackPanel>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ebenen (keine = alle)" Foreground="#5F5E5A"/>
                <Border Grid.Row="1" BorderBrush="#DCDAD2" BorderThickness="1" Margin="0,2,0,6">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="e_ebenen" Margin="4"/></ScrollViewer>
                </Border>
                <TextBlock Grid.Row="2" x:Name="e_inhalt_titel" Foreground="#5F5E5A"/>
                <Border Grid.Row="3" BorderBrush="#DCDAD2" BorderThickness="1" Margin="0,2,0,0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="e_inhalt" Margin="4"/></ScrollViewer>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="  2 · Prüfen  ">
        <DockPanel Margin="8">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Durchbruch-Paket:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="p_paket" Width="240" Height="26"/>
            <TextBox x:Name="p_suche" Height="26" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Nummer, Familie oder Typ suchen"/>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button x:Name="p_alle" Content="Alle" Padding="8,2"/>
            <Button x:Name="p_keine" Content="Keine" Padding="8,2" Margin="6,0,0,0"/>
            <Button x:Name="p_vorschlag" Content="Nur Neue/Geänderte" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="Unveränderte Exemplare abwählen – nur, was sich seit dem letzten Einreichen geändert hat"/>
            <Button x:Name="p_revit" Content="Nur Revit-Auswahl" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="Nur die Exemplare anhaken, die gerade in Revit markiert sind"/>
            <Button x:Name="p_aus_ansicht" Content="Aus Ansicht übernehmen" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="In der Paket-Ansicht von Hand ausgeblendete Durchbrüche abwählen"/>
            <Button x:Name="p_3d" Content="In 3D zeigen" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="Paket-Ansicht mit der aktuellen Auswahl öffnen – das Fenster bleibt offen"/>
          </WrapPanel>
          <TextBlock x:Name="p_summe" DockPanel.Dock="Bottom" Foreground="#5F5E5A" Margin="0,6,0,0"/>
          <TreeView x:Name="p_baum" BorderBrush="#DCDAD2"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="  3 · Einreichen  ">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Prüfrunde" Foreground="#5F5E5A"/>
            <TextBox x:Name="r_runde" Height="26" Margin="0,2,0,8" VerticalContentAlignment="Center"/>
            <TextBlock Text="Diese Pakete einreichen bzw. veröffentlichen:" Foreground="#5F5E5A"/>
            <Border BorderBrush="#DCDAD2" BorderThickness="1" Margin="0,2,0,8" MaxHeight="180">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="r_pakete" Margin="6"/></ScrollViewer>
            </Border>
            <CheckBox x:Name="r_entfallen" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="k_los" Content="Einreichen und veröffentlichen" Padding="14,4" FontWeight="SemiBold"/>
              <Button x:Name="k_viewer" Content="Viewer öffnen" Padding="10,4" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="r_log" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="#F1EFE8" BorderThickness="0" FontFamily="Consolas"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
