<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBK – Prüfset" Width="520" Height="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#5F5E5A" Margin="0,0,0,8"
               Text="Welche Bauteile reicht Ihre Firma zur Prüfung ein? Kategorie, Familie oder Typ anhaken."/>
    <TextBox x:Name="suche" DockPanel.Dock="Top" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center" ToolTip="Familie oder Typ suchen"/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="summe" VerticalAlignment="Center" Foreground="#5F5E5A"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="knopf_ok" Content="Speichern" Width="90" IsDefault="True"/>
        <Button x:Name="knopf_abbrechen" Content="Abbrechen" Width="90" Margin="6,0,0,0" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
    <TreeView x:Name="baum" BorderBrush="#DCDAD2"/>
  </DockPanel>
</Window>
