<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelle zum Viewer" Width="980" Height="600" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5"
        Foreground="#18181b" Background="#fafafa">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#18181b"/>
    <SolidColorBrush x:Key="Grau" Color="#71717a"/>
    <SolidColorBrush x:Key="Linie" Color="#e4e4e7"/>
    <SolidColorBrush x:Key="LinieStark" Color="#d4d4d8"/>
    <SolidColorBrush x:Key="Flaeche" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Rot" Color="#be0a26"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#a1a1aa"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Haupt" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Rot}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rot}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Spalte" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Grau}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Kopf -->
    <Border DockPanel.Dock="Top" Background="White" Padding="22,14" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Rot}" CornerRadius="5" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="DBK" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Modelle zum Viewer" FontSize="21" FontWeight="Bold"/>
          <TextBlock x:Name="untertitel" Foreground="{StaticResource Grau}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="m_viewer" Grid.Column="2" Content="Viewer öffnen" VerticalAlignment="Center"
                ToolTip="Viewer im Browser öffnen – die Modelle erscheinen links in der Seitenleiste"/>
      </Grid>
    </Border>

    <!-- Statuszeile -->
    <Border DockPanel.Dock="Bottom" Background="White" Padding="22,9" BorderBrush="{StaticResource Linie}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar x:Name="busy" Width="110" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" Foreground="{StaticResource Rot}"/>
          <CheckBox x:Name="m_erzwingen" Content="Auch unveränderte" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="Normalerweise werden Modelle übersprungen, die seit dem letzten Export nicht gespeichert/synchronisiert wurden"/>
          <Button x:Name="m_los" Style="{StaticResource Haupt}" Content="Exportieren"
                  ToolTip="Angehakte Zeilen exportieren und in den Projektordner stellen – alle sehen sie im Viewer"/>
        </StackPanel>
        <TextBlock x:Name="status" Text="Bereit" TextWrapping="Wrap" Foreground="{StaticResource Grau}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Hinweise zum Format -->
    <Border DockPanel.Dock="Bottom" Margin="22,0,22,12" Padding="14,10" Background="{StaticResource Flaeche}" CornerRadius="8">
      <StackPanel>
        <TextBlock x:Name="m_hilfe_fbx" TextWrapping="Wrap" Foreground="{StaticResource Grau}"/>
        <TextBlock x:Name="m_hilfe_ifc" TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,4,0,0"
                   Text="Durchbrüche werden nie mit exportiert – sie kommen als Stände über „Einreichen“. Passt die Lage eines Modells im Viewer nicht, lässt es sich dort verschieben und drehen."/>
      </StackPanel>
    </Border>

    <!-- Liste -->
    <Border Margin="22,12,22,12" Background="White" CornerRadius="12" BorderBrush="{StaticResource Linie}" BorderThickness="1" Padding="18,12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="36"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Style="{StaticResource Spalte}" Text="3D-Ansicht in Revit"/>
          <TextBlock Grid.Column="2" Style="{StaticResource Spalte}" Text="Name im Viewer"/>
          <TextBlock Grid.Column="3" Style="{StaticResource Spalte}" Text="Verknüpfungen"/>
          <TextBlock Grid.Column="4" Style="{StaticResource Spalte}" Text="Format"/>
          <TextBlock Grid.Column="5" Style="{StaticResource Spalte}" Text="Zuletzt exportiert"/>
        </Grid>
        <Button x:Name="m_neu" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="+ Ansicht hinzufügen" Margin="0,10,0,0"
                ToolTip="Weitere 3D-Ansicht exportieren, z. B. je Gewerk oder je Bauteil eine eigene"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="zeilen"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
