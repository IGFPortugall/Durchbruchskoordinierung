<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Durchbruchskoordination" Width="1120" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5"
        Foreground="#18181b" Background="#fafafa">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#18181b"/>
    <SolidColorBrush x:Key="Grau" Color="#71717a"/>
    <SolidColorBrush x:Key="Linie" Color="#e4e4e7"/>
    <SolidColorBrush x:Key="LinieStark" Color="#d4d4d8"/>
    <SolidColorBrush x:Key="Flaeche" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Rot" Color="#be0a26"/>
    <SolidColorBrush x:Key="RotHell" Color="#fff1f3"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#a1a1aa"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Haupt" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Rot}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rot}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Etikett" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Grau}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <Style x:Key="Karte" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="BorderBrush" Value="{StaticResource Linie}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Reiter" Background="White" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}" Margin="0,0,2,0" Cursor="Hand">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Reiter" Property="BorderBrush" Value="{StaticResource Rot}"/>
                <Setter TargetName="Reiter" Property="Background" Value="{StaticResource RotHell}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Kopf -->
    <Border DockPanel.Dock="Top" Background="White" Padding="22,14" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Rot}" CornerRadius="5" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="DBK" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Durchbruchskoordination" FontSize="21" FontWeight="Bold"/>
          <TextBlock x:Name="untertitel" Foreground="{StaticResource Grau}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="k_hinweis" Content="Nächster Hinweis" Margin="0,0,6,0"
                  ToolTip="Springt zum nächsten offenen Punkt: fehlende Angaben, abgelehnte Durchbrüche, nicht eingereichte Änderungen"/>
          <Button x:Name="k_revit" Content="In Revit zeigen" Margin="0,0,6,0"
                  ToolTip="Markierten Durchbruch bzw. die Exportansicht der markierten Modell-Vorlage in Revit zeigen"/>
          <Button x:Name="k_viewer" Content="Viewer öffnen"
                  ToolTip="Viewer im Browser: alle Durchbrüche und Modelle, Kommentare, Freigeben/Ablehnen – für alle Beteiligten gleich"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Statuszeile -->
    <Border DockPanel.Dock="Bottom" Background="White" Padding="22,9" BorderBrush="{StaticResource Linie}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar x:Name="busy" Width="110" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" Foreground="{StaticResource Rot}"/>
          <Button x:Name="k_weiter" Style="{StaticResource Haupt}" Content="Weiter →"/>
        </StackPanel>
        <TextBlock x:Name="status" Text="Bereit" TextWrapping="Wrap" Foreground="{StaticResource Grau}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="tabs" Margin="22,12,22,12" BorderThickness="0" Background="Transparent" Padding="0,12,0,0">

      <!-- 1 Projekt -->
      <TabItem x:Name="t_projekt">
        <TabItem.Header><TextBlock x:Name="h_projekt" Text="Projekt"/></TabItem.Header>
        <Border Style="{StaticResource Karte}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Projekt und Person" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Etikett}" Text="Projektordner (gemeinsamer Ordner aller Beteiligten)"/>
              <DockPanel>
                <Button x:Name="p_ordner_waehlen" DockPanel.Dock="Right" Content="Wählen …" Margin="6,0,0,0"/>
                <TextBox x:Name="p_ordner"/>
              </DockPanel>
              <TextBlock x:Name="p_projekt_info" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
              <TextBlock Style="{StaticResource Etikett}" Text="Projektname (sehen alle – im Viewer und in jedem Revit-Fenster)"/>
              <TextBox x:Name="p_projektname" ToolTip="Steht im Projektordner (projekt.json). Ändern gilt für alle Beteiligten."/>
              <TextBlock Style="{StaticResource Etikett}" Text="Name"/>
              <TextBox x:Name="p_name"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Etikett}" Text="Firma"/><ComboBox x:Name="p_firma" IsEditable="True"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Etikett}" Text="Rolle"/><ComboBox x:Name="p_rolle"/></StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Etikett}" Text="Kürzel dieses Modells (z. B. HLS, ELT, ARC)"/>
              <TextBox x:Name="p_kuerzel"/>
              <CheckBox x:Name="p_plant" Margin="0,14,0,0" Content="Ich plane selbst Durchbrüche (Reiter „Durchbrüche“ anzeigen)"/>
              <Button x:Name="p_speichern" Style="{StaticResource Haupt}" Content="Übernehmen" HorizontalAlignment="Left" Margin="0,18,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="So geht es weiter" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,10,0,0" LineHeight="20"
                         Text="1.  Projektordner wählen – damit ist das Projekt bestimmt. Alle Beteiligten wählen denselben (synchronisierten) Ordner. Die Zuordnung wird im Revit-Modell gespeichert."/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,6,0,0" LineHeight="20"
                         Text="2.  Ansichten: welche 3D-Ansichten (Modelle) und 2D-Ansichten (Grundrisse, Schnitte mit Beschriftung) im Viewer zu sehen sind."/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,6,0,0" LineHeight="20"
                         Text="3.  Durchbrüche: Familien festlegen, Stand = 3D-Ansicht wählen."/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,6,0,0" LineHeight="20"
                         Text="4.  Einreichen – geprüft wird im Viewer."/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grau}" Margin="0,14,0,0" FontSize="11.5"
                         Text="Geschosse ermittelt das Werkzeug aus den Ebenen (Hilfsebenen wie OK, UK, RD, FBH werden zusammengefasst). Ein Durchbruch gehört zum nächsten Geschoss darunter."/>
            </StackPanel>
          </Grid>
        </Border>
      </TabItem>

      <!-- 2 Ansichten für den Viewer -->
      <TabItem x:Name="t_ansichten">
        <TabItem.Header><TextBlock Text="Ansichten"/></TabItem.Header>
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14,10" Background="{StaticResource Flaeche}" CornerRadius="8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox x:Name="a_erzwingen" Content="Auch unveränderte" VerticalAlignment="Center" Margin="12,0,12,0"
                          ToolTip="Normalerweise werden Ansichten übersprungen, wenn das Modell seit dem letzten Export nicht gespeichert/synchronisiert wurde"/>
                <Button x:Name="a_los" Style="{StaticResource Haupt}" Content="Ansichten zum Viewer"
                        ToolTip="Angehakte 3D- und 2D-Ansichten exportieren und in den Projektordner stellen – alle sehen sie im Viewer"/>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="a_hilfe_fbx" TextWrapping="Wrap" Foreground="{StaticResource Grau}" FontSize="11.5"/>
                <TextBlock x:Name="a_hilfe_ifc" TextWrapping="Wrap" Foreground="{StaticResource Grau}" FontSize="11.5" Margin="0,3,0,0"/>
                <CheckBox x:Name="a_ohne_durch" Margin="0,6,0,0" IsChecked="True" Foreground="{StaticResource Grau}">
                  <TextBlock x:Name="a_hilfe_durch" TextWrapping="Wrap" FontSize="11.5"/>
                </CheckBox>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="12"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Karte}" Padding="18,12">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                  <Button x:Name="a_neu" DockPanel.Dock="Right" Content="+ 3D-Ansicht"
                          ToolTip="Weitere 3D-Ansicht exportieren, z. B. je Gewerk oder je Bauteil eine eigene"/>
                  <TextBlock Text="3D – Modelle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,8,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="36"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Style="{StaticResource Etikett}" Margin="0" Text="3D-Ansicht in Revit"/>
                  <TextBlock Grid.Column="2" Style="{StaticResource Etikett}" Margin="0" Text="Name im Viewer"/>
                  <TextBlock Grid.Column="3" Style="{StaticResource Etikett}" Margin="0" Text="Verknüpfungen"/>
                  <TextBlock Grid.Column="4" Style="{StaticResource Etikett}" Margin="0" Text="Format"/>
                  <TextBlock Grid.Column="5" Style="{StaticResource Etikett}" Margin="0" Text="Zuletzt exportiert"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="a_zeilen"/></ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Karte}" Padding="18,12">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                  <Button x:Name="a_plan_neu" DockPanel.Dock="Right" Content="+ Grundriss / Schnitt"
                          ToolTip="Grundriss oder Schnitt mit Beschriftern, Bemaßung und Achsen – liegt im Viewer passgenau über dem Modell"/>
                  <TextBlock Text="2D – Grundrisse und Schnitte" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,8,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="36"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Style="{StaticResource Etikett}" Margin="0" Text="Ansicht in Revit"/>
                  <TextBlock Grid.Column="2" Style="{StaticResource Etikett}" Margin="0" Text="Name im Viewer"/>
                  <TextBlock Grid.Column="3" Style="{StaticResource Etikett}" Margin="0" Text="Zuletzt exportiert"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="a_plaene"/></ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- 3 Durchbrüche -->
      <TabItem x:Name="t_durch">
        <TabItem.Header><TextBlock x:Name="h_durch" Text="Durchbrüche"/></TabItem.Header>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Karte}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Familien in der Koordination" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,4,0,8"
                         Text="Einmal festlegen, welche Familien/Typen Durchbrüche sind."/>
              <Button DockPanel.Dock="Bottom" x:Name="d_familien_ok" Content="Übernehmen und neu einlesen" Margin="0,8,0,0"/>
              <TreeView x:Name="d_familien" BorderBrush="{StaticResource Linie}"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Karte}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="d_stand_neu" Content="Neuer Stand …" Margin="6,0,0,0"/>
                  <Button x:Name="d_stand_weg" Content="Löschen" Margin="6,0,0,0" ToolTip="Nur hier aus der Liste – zum Entfernen für alle: Reiter „Einreichen“ › Stand zurückziehen"/>
                </StackPanel>
                <TextBlock Text="Stand" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="d_stand" ToolTip="Ein Stand ist ein Paket von Durchbrüchen, z. B. „EG Rohbau“ – im Viewer einzeln ein-/ausblendbar"/>
              </DockPanel>
              <Border DockPanel.Dock="Top" Background="#f4f4f5" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock Text="3D-Ansicht" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Grau}"
                             ToolTip="Alle Durchbrüche der Koordinations-Familien, die in dieser 3D-Ansicht sichtbar sind, gehören zum Stand. In Revit ausblenden = nicht im Stand."/>
                  <Button x:Name="d_ansicht_neu" DockPanel.Dock="Right" Content="Ansicht anlegen" Margin="6,0,0,0" Padding="8,3"
                          ToolTip="Legt „DBK Stand – Name“ an, in der nur Durchbrüche sichtbar sind. Danach in Revit ausblenden, was nicht dazugehört, und „Neu lesen“."/>
                  <Button x:Name="d_ansicht_lesen" DockPanel.Dock="Right" Content="Neu lesen" Margin="6,0,0,0" Padding="8,3"
                          ToolTip="Sichtbare Durchbrüche der Ansicht neu einlesen (nach Änderungen in Revit)"/>
                  <ComboBox x:Name="d_ansicht"/>
                </DockPanel>
              </Border>
              <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
                <TextBlock Text="Anzeigen" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Grau}"/>
                <ComboBox x:Name="d_filter" Width="170"/>
                <TextBox x:Name="d_suche" Margin="10,0,0,0" ToolTip="Nummer, Familie oder Typ suchen"/>
              </DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="d_zeigen" DockPanel.Dock="Left" Content="Stand in Revit zeigen"
                        ToolTip="3D-Kontrollansicht: neu/geändert orange, unverändert grau – das Fenster bleibt offen"/>
                <TextBlock x:Name="d_summe" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" Foreground="{StaticResource Grau}"/>
              </DockPanel>
              <TreeView x:Name="d_liste" BorderBrush="{StaticResource Linie}"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- 4 Einreichen / Veröffentlichen -->
      <TabItem x:Name="t_einreichen">
        <TabItem.Header><TextBlock x:Name="h_einreichen" Text="Einreichen"/></TabItem.Header>
        <Border Style="{StaticResource Karte}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="e_titel" Text="Zusammenfassung" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="e_zusammenfassung" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
              <StackPanel x:Name="e_runde_box">
                <TextBlock Style="{StaticResource Etikett}" Text="Prüfrunde"/>
                <TextBox x:Name="e_runde" Width="420" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="e_los" Style="{StaticResource Haupt}" Content="Einreichen" Padding="18,8"/>
                <Button x:Name="e_viewer" Content="Viewer öffnen" Margin="8,0,0,0" Padding="14,8"/>
                <Button x:Name="e_zurueck" Content="Stand zurückziehen" Margin="24,0,0,0" Padding="14,8"
                        ToolTip="Alle Durchbrüche dieses Stands verschwinden für alle aus der Koordination"/>
              </StackPanel>
            </StackPanel>
            <TextBox x:Name="e_log" Margin="0,16,0,0" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Background="#f4f4f5" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
