<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Durchbruchskoordination" Width="1120" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5"
        Foreground="#18181b" Background="#fafafa">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#18181b"/>
    <SolidColorBrush x:Key="Grau" Color="#71717a"/>
    <SolidColorBrush x:Key="Linie" Color="#e4e4e7"/>
    <SolidColorBrush x:Key="LinieStark" Color="#d4d4d8"/>
    <SolidColorBrush x:Key="Flaeche" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="Rot" Color="#be0a26"/>
    <SolidColorBrush x:Key="RotHell" Color="#fff1f3"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#a1a1aa"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Haupt" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Rot}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rot}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource LinieStark}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Etikett" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Grau}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <Style x:Key="Karte" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="BorderBrush" Value="{StaticResource Linie}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Reiter" Background="White" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}" Margin="0,0,2,0" Cursor="Hand">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Reiter" Property="BorderBrush" Value="{StaticResource Rot}"/>
                <Setter TargetName="Reiter" Property="Background" Value="{StaticResource RotHell}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Kopf -->
    <Border DockPanel.Dock="Top" Background="White" Padding="22,14" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Rot}" CornerRadius="5" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="DBK" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Durchbruchskoordination" FontSize="21" FontWeight="Bold"/>
          <TextBlock x:Name="untertitel" Foreground="{StaticResource Grau}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="k_hinweis" Content="Nächster Hinweis" Margin="0,0,6,0"
                  ToolTip="Springt zum nächsten offenen Punkt: fehlende Angaben, abgelehnte Durchbrüche, nicht eingereichte Änderungen"/>
          <Button x:Name="k_revit" Content="In Revit zeigen" Margin="0,0,6,0"
                  ToolTip="Markierten Durchbruch bzw. die Exportansicht der markierten Modell-Vorlage in Revit zeigen"/>
          <Button x:Name="k_viewer" Content="Viewer öffnen"
                  ToolTip="Viewer im Browser: alle Durchbrüche und Modelle, Kommentare, Freigeben/Ablehnen – für alle Beteiligten gleich"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Statuszeile -->
    <Border DockPanel.Dock="Bottom" Background="White" Padding="22,9" BorderBrush="{StaticResource Linie}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar x:Name="busy" Width="110" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" Foreground="{StaticResource Rot}"/>
          <Button x:Name="k_weiter" Style="{StaticResource Haupt}" Content="Weiter →"/>
        </StackPanel>
        <TextBlock x:Name="status" Text="Bereit" TextWrapping="Wrap" Foreground="{StaticResource Grau}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="tabs" Margin="22,12,22,12" BorderThickness="0" Background="Transparent" Padding="0,12,0,0">

      <!-- 1 Projekt -->
      <TabItem x:Name="t_projekt">
        <TabItem.Header><TextBlock x:Name="h_projekt" Text="Projekt"/></TabItem.Header>
        <Border Style="{StaticResource Karte}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Projekt und Person" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Etikett}" Text="Projektordner (gemeinsamer Ordner aller Beteiligten)"/>
              <DockPanel>
                <Button x:Name="p_ordner_waehlen" DockPanel.Dock="Right" Content="Wählen …" Margin="6,0,0,0"/>
                <TextBox x:Name="p_ordner"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Etikett}" Text="Name"/>
              <TextBox x:Name="p_name"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Etikett}" Text="Firma"/><ComboBox x:Name="p_firma" IsEditable="True"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Etikett}" Text="Rolle"/><ComboBox x:Name="p_rolle"/></StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Etikett}" Text="Kürzel dieses Modells (z. B. HLS, ELT, ARC)"/>
              <TextBox x:Name="p_kuerzel"/>
              <CheckBox x:Name="p_plant" Margin="0,14,0,0" Content="Ich plane selbst Durchbrüche (Reiter „Durchbrüche“ anzeigen)"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Ansichten in Revit" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Etikett}" Text="Vorlage für 2D-Prüfansichten (Grundriss)"/>
              <ComboBox x:Name="p_vorlage_2d"/>
              <TextBlock Style="{StaticResource Etikett}" Text="Vorlage für die 3D-Prüfansicht"/>
              <ComboBox x:Name="p_vorlage_3d"/>
              <DockPanel Margin="0,14,0,3">
                <Button x:Name="p_geschoss_vorschlag" DockPanel.Dock="Right" Content="Vorschlag" Padding="8,2"
                        ToolTip="Hilfsebenen (OK, UK, RD, RB, FBH, Hohlkörper, NN …) abwählen"/>
                <TextBlock Text="Geschosse – welche Ebenen zählen? (Hilfsebenen zusammenfassen)" Foreground="{StaticResource Grau}"
                           FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <Border BorderBrush="{StaticResource Linie}" BorderThickness="1" Height="170">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="p_geschosse" Margin="6"/></ScrollViewer>
              </Border>
              <TextBlock Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                         Text="Ein Durchbruch gehört zum nächsten Geschoss darunter. Das Werkzeug legt eigene Ansichten an („DBK …“); bestehende Ansichten bleiben unverändert."/>
              <Button x:Name="p_speichern" Style="{StaticResource Haupt}" Content="Übernehmen" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </TabItem>

      <!-- 2 Durchbrüche -->
      <TabItem x:Name="t_durch">
        <TabItem.Header><TextBlock x:Name="h_durch" Text="Durchbrüche"/></TabItem.Header>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Karte}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Familien in der Koordination" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,4,0,8"
                         Text="Einmal festlegen, welche Familien/Typen Durchbrüche sind."/>
              <Button DockPanel.Dock="Bottom" x:Name="d_familien_ok" Content="Übernehmen und neu einlesen" Margin="0,8,0,0"/>
              <TreeView x:Name="d_familien" BorderBrush="{StaticResource Linie}"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Karte}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="d_vorlage_speichern" Content="Speichern" Margin="6,0,0,0" ToolTip="Ebene und zurückgehaltene Durchbrüche in der Vorlage speichern"/>
                  <Button x:Name="d_vorlage_neu" Content="Neu …" Margin="6,0,0,0"/>
                  <Button x:Name="d_vorlage_weg" Content="Löschen" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Auswahlvorlage" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="d_vorlage" ToolTip="Gespeicherte Auswahl, z. B. „EG Rohbau“. Neu hinzugekommene passende Durchbrüche werden automatisch angehakt."/>
              </DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                <TextBlock Text="Ebene" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Grau}"/>
                <ComboBox x:Name="d_ebene" Width="200"/>
                <TextBlock Text="Anzeigen" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="{StaticResource Grau}"/>
                <ComboBox x:Name="d_filter" Width="170"/>
                <TextBox x:Name="d_suche" Margin="10,0,0,0" ToolTip="Nummer, Familie oder Typ suchen"/>
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" x:Name="d_info" Margin="0,8,0,4" Foreground="{StaticResource Rot}" TextWrapping="Wrap"/>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="d_summe" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Grau}"/>
                <WrapPanel>
                  <Button x:Name="d_alle" Content="Alle" Margin="0,0,6,0"/>
                  <Button x:Name="d_keine" Content="Keine" Margin="0,0,6,0"/>
                  <Button x:Name="d_markierung" Content="Revit-Markierung übernehmen" Margin="0,0,6,0"
                          ToolTip="Nur die in Revit markierten Durchbrüche anhaken"/>
                  <Button x:Name="d_zeigen" Content="Auswahl in Revit zeigen"
                          ToolTip="3D-Ansicht „DBK Einreichen – Name“: angehakt orange, zurückgehalten grau – das Fenster bleibt offen"/>
                </WrapPanel>
              </DockPanel>
              <TreeView x:Name="d_liste" BorderBrush="{StaticResource Linie}"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- 3 Modell -->
      <TabItem x:Name="t_modell">
        <TabItem.Header><TextBlock x:Name="h_modell" Text="Modell"/></TabItem.Header>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Karte}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Was geht als Modell in den Viewer?" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,4,0,8"
                         Text="Jede Vorlage hat eine eigene 3D-Ansicht in Revit. Exportiert wird genau, was dort sichtbar ist – Durchbrüche nie. Im Viewer wird jede Vorlage ein eigenes, schaltbares Modell."/>
              <Border DockPanel.Dock="Bottom" Background="#f4f4f5" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                <DockPanel>
                  <Button x:Name="m_aktualisieren" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Modell aktualisieren"
                          VerticalAlignment="Center" Padding="16,7"
                          ToolTip="Exportiert alle angehakten Vorlagen und stellt sie in den Viewer – unabhängig vom Einreichen der Durchbrüche"/>
                  <StackPanel>
                    <TextBlock x:Name="m_hinweis" TextWrapping="Wrap" Foreground="{StaticResource Grau}"/>
                    <CheckBox x:Name="m_erzwingen" Content="Auch exportieren, wenn sich das Modell nicht geändert hat" Margin="0,6,0,0"
                              ToolTip="Normalerweise wird übersprungen, wenn Modellstand und Vorlage seit dem letzten Export gleich sind. Ansichtsänderungen ohne Speichern erkennt Revit nicht – dann hier anhaken."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="m_neu" Content="+ Vorlage" Margin="0,0,6,0"/>
                <Button x:Name="m_weg" Content="Entfernen" Margin="0,0,6,0"/>
                <Button x:Name="m_ansicht" Content="Exportansicht zeigen" ToolTip="Ansicht „DBK Paket – Name“ aufbauen und öffnen; danach in Revit nach Bedarf ausblenden, filtern, Schnittbox setzen"/>
              </WrapPanel>
              <ListBox x:Name="m_liste" BorderBrush="{StaticResource Linie}" DisplayMemberPath="text"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Karte}">
            <DockPanel x:Name="m_editor">
              <StackPanel DockPanel.Dock="Top">
                <CheckBox x:Name="m_aktiv" Content="Beim Einreichen mitschicken" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Etikett}" Text="Name"/>
                <TextBox x:Name="m_name"/>
                <TextBlock Style="{StaticResource Etikett}" Text="Kürzel im Viewer"/>
                <TextBox x:Name="m_kuerzel"/>
                <TextBlock Style="{StaticResource Etikett}" Text="Format"/>
                <ComboBox x:Name="m_format"/>
                <TextBlock x:Name="m_format_info" Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"/>
                <TextBlock x:Name="m_stand" Foreground="{StaticResource Grau}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
              <Button DockPanel.Dock="Bottom" x:Name="m_speichern" Content="Speichern" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Etikett}" Text="Gewerke"/>
                <Border Grid.Row="1" BorderBrush="{StaticResource Linie}" BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="m_gewerke" Margin="6"/></ScrollViewer>
                </Border>
                <TextBlock Grid.Row="2" Style="{StaticResource Etikett}" Text="Ebenen (keine = alle)"/>
                <Border Grid.Row="3" BorderBrush="{StaticResource Linie}" BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="m_ebenen" Margin="6"/></ScrollViewer>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- 4 Einreichen / Veröffentlichen -->
      <TabItem x:Name="t_einreichen">
        <TabItem.Header><TextBlock x:Name="h_einreichen" Text="Einreichen"/></TabItem.Header>
        <Border Style="{StaticResource Karte}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="e_titel" Text="Zusammenfassung" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="e_zusammenfassung" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
              <StackPanel x:Name="e_runde_box">
                <TextBlock Style="{StaticResource Etikett}" Text="Prüfrunde"/>
                <TextBox x:Name="e_runde" Width="420" HorizontalAlignment="Left"/>
              </StackPanel>
              <CheckBox x:Name="e_entfallen" Margin="0,12,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="e_los" Style="{StaticResource Haupt}" Content="Einreichen" Padding="18,8"/>
                <Button x:Name="e_viewer" Content="Viewer öffnen" Margin="8,0,0,0" Padding="14,8"/>
              </StackPanel>
            </StackPanel>
            <TextBox x:Name="e_log" Margin="0,16,0,0" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" Background="#f4f4f5" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
