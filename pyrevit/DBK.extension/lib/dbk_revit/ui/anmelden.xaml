<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBK – Anmelden" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
  <StackPanel Margin="16">
    <TextBlock Text="Projektordner" Foreground="#5F5E5A"/>
    <DockPanel Margin="0,2,0,8">
      <Button x:Name="knopf_ordner" DockPanel.Dock="Right" Content="…" Width="30" Margin="6,0,0,0" ToolTip="Gemeinsamen Ordner mit projekt.json wählen"/>
      <TextBox x:Name="ordner" Height="26" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="Name" Foreground="#5F5E5A"/>
    <TextBox x:Name="name" Height="26" Margin="0,2,0,8" VerticalContentAlignment="Center"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Firma" Foreground="#5F5E5A"/>
        <ComboBox x:Name="firma" IsEditable="True" Height="26" Margin="0,2,0,0" ToolTip="Ihr Ordner im Projektordner heißt wie die Firma"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Rolle" Foreground="#5F5E5A"/>
        <ComboBox x:Name="rolle" Height="26" Margin="0,2,0,0" ToolTip="Rollen kommen aus der Projekt-Verwaltung (projekt.json)"/>
      </StackPanel>
    </Grid>
    <TextBlock Text="Kürzel dieses Modells" Foreground="#5F5E5A"/>
    <TextBox x:Name="kuerzel" Height="26" Margin="0,2,0,8" VerticalContentAlignment="Center"
             ToolTip="Kurzname für dieses Revit-Modell, z. B. HLS oder ELT – wird Teil der Durchbruchs-ID"/>
    <Expander Header="Ansichten" Margin="0,4,0,8">
      <StackPanel Margin="0,6,0,0">
        <TextBlock Text="Vorlage für 2D-Prüfansichten (Grundriss)" Foreground="#5F5E5A"/>
        <ComboBox x:Name="vorlage_2d" Height="26" Margin="0,2,0,8"
                  ToolTip="Wird auf „DBK 2D – Ebene – Name“ angewendet. Leer = Revit-Standard."/>
        <TextBlock Text="Vorlage für 3D-Prüfansicht" Foreground="#5F5E5A"/>
        <ComboBox x:Name="vorlage_3d" Height="26" Margin="0,2,0,8"
                  ToolTip="Wird auf „DBK 3D – Name“ angewendet. Verknüpfungen sollten sichtbar sein."/>
        <TextBlock Text="Viewer-Adresse" Foreground="#5F5E5A"/>
        <TextBox x:Name="viewer_url" Height="26" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
      </StackPanel>
    </Expander>
    <TextBlock x:Name="meldung" Foreground="#A32D2D" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="knopf_ok" Content="Speichern" Width="90" IsDefault="True"/>
      <Button x:Name="knopf_abbrechen" Content="Abbrechen" Width="90" Margin="6,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
