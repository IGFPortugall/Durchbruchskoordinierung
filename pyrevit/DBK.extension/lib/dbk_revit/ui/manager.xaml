<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBK Prüf-Manager" Width="1060" Height="680" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#FAFAF8">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="kopf" DockPanel.Dock="Right" Foreground="#5F5E5A" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="suche" Width="190" Height="26" VerticalContentAlignment="Center" ToolTip="Nummer, Größe oder Text im Verlauf suchen"/>
        <ComboBox x:Name="filter_status" Width="130" Height="26" Margin="6,0,0,0" ToolTip="Nach Gesamtstatus filtern"/>
        <ComboBox x:Name="filter_ebene" Width="170" Height="26" Margin="6,0,0,0" ToolTip="Nach Geschoss filtern"/>
        <CheckBox x:Name="filter_ich" Content="Wartet auf mich" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip="Nur Durchbrüche, bei denen Sie als Nächstes etwas tun müssen"/>
        <Button x:Name="knopf_neu" Content="Aktualisieren" Margin="12,0,0,0" Padding="10,2" ToolTip="Projektordner neu einlesen (passiert sonst automatisch alle 5 Sekunden)"/>
        <Button x:Name="knopf_viewer" Content="Im Viewer öffnen" Margin="6,0,0,0" Padding="10,2" ToolTip="Web-Viewer im Browser öffnen"/>
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="meldung" DockPanel.Dock="Bottom" Foreground="#A32D2D" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>
      <ListView x:Name="liste" Grid.Column="0" Margin="0,0,10,0" BorderBrush="#DCDAD2">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Nummer" Width="150" DisplayMemberBinding="{Binding nummer}"/>
            <GridViewColumn Header="Status" Width="150">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding farbe_bg}" CornerRadius="6" Padding="6,1">
                    <TextBlock Text="{Binding status}" Foreground="{Binding farbe_text}"/>
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Ebene" Width="130" DisplayMemberBinding="{Binding ebene}"/>
            <GridViewColumn Header="Bauteil" Width="150" DisplayMemberBinding="{Binding wirt}"/>
            <GridViewColumn Header="Größe" Width="90" DisplayMemberBinding="{Binding groesse}"/>
            <GridViewColumn Header="Pflicht" Width="55" DisplayMemberBinding="{Binding pflicht}"/>
          </GridView>
        </ListView.View>
      </ListView>
      <Border Grid.Column="1" Background="White" BorderBrush="#DCDAD2" BorderThickness="1" CornerRadius="8" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel>
              <Border x:Name="status_rahmen" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                <TextBlock x:Name="status_text"/>
              </Border>
              <TextBlock x:Name="titel" FontSize="15" FontWeight="SemiBold" Text="Durchbruch auswählen"/>
            </DockPanel>
            <TextBlock x:Name="meta" Foreground="#5F5E5A" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="knopf_2d" Content="2D" Width="60" ToolTip="Grundriss der Ebene öffnen, auf den Durchbruch zugeschnitten (Ansicht „DBK 2D – Ebene – Name“, Vorlage aus Anmelden)"/>
              <Button x:Name="knopf_3d" Content="3D" Width="60" Margin="6,0,0,0" ToolTip="3D-Ansicht mit Schnittbox um den Durchbruch, Verknüpfungen sichtbar (Ansicht „DBK 3D – Name“)"/>
              <Button x:Name="knopf_auswahl" Content="Auswählen" Width="80" Margin="6,0,0,0" ToolTip="Im Modell auswählen und anzeigen (nur Bauteile aus diesem Modell)"/>
            </StackPanel>
            <TextBlock Text="Freigaben" Foreground="#888780" Margin="0,4,0,2"/>
            <StackPanel x:Name="rollen"/>
            <TextBlock Text="Verlauf" Foreground="#888780" Margin="0,10,0,2"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBox x:Name="kommentar" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     ToolTip="Kommentar zur Entscheidung oder Nachricht an alle"/>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="knopf_frei" Content="Freigeben" Padding="10,3" Foreground="#3B6D11" ToolTip="Für Ihre Rolle freigeben"/>
              <Button x:Name="knopf_ab" Content="Ablehnen" Padding="10,3" Margin="6,0,0,0" Foreground="#A32D2D" ToolTip="Ablehnen – bitte Grund im Kommentar angeben"/>
              <ComboBox x:Name="weitere" Width="120" Margin="6,0,0,0" ToolTip="Weiterer Status (in der Verwaltung festgelegt)"/>
              <Button x:Name="knopf_senden" Content="Senden" Padding="10,3" Margin="6,0,0,0" ToolTip="Nur Nachricht senden"/>
              <Button x:Name="knopf_erneut" Content="Erneut einreichen" Padding="10,3" Margin="6,0,0,0"
                      ToolTip="Unverändert erneut zur Prüfung einreichen, z. B. nach Klärung im Chat"/>
            </WrapPanel>
          </StackPanel>
          <ScrollViewer x:Name="verlauf_scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="verlauf"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
